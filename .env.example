# Copy to .env and replace each password with a separate random hex value:
# openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_random_admin_password
MIGRATION_PASSWORD=replace_with_random_migrator_password
RUNTIME_PASSWORD=replace_with_random_runtime_password

# Source-running URLs. Percent-encode non-hex password characters in URLs.
DATABASE_URL=postgresql://yinsen_runtime:${RUNTIME_PASSWORD}@127.0.0.1:55432/yinsen
MIGRATION_DATABASE_URL=postgresql://yinsen_migrator:${MIGRATION_PASSWORD}@127.0.0.1:55432/yinsen
# disable is allowed only for localhost and the private Compose postgres service.
# Remote PostgreSQL requires verify-full and a trusted certificate.
DATABASE_SSL=disable
APP_ORIGIN=http://localhost:3000

# Local bindings; use an HTTPS reverse proxy for an internet-facing installation.
APP_PORT=3000
POSTGRES_PORT=55432

# Optional Resend. Omit both for manual client links. Partial configuration
# refuses startup. Prefer a Sending-access key restricted to your verified domain.
# Setup's explicit verification sends to Resend's fixed delivered@resend.dev
# test address (uses quota); API acceptance does not prove inbox delivery.
# Disable click tracking for login links.
# RESEND_API_KEY=re_replace_with_your_key
# EMAIL_FROM_ADDRESS=portal@your-verified-domain.example

# Optional direct Stripe hosted card Checkout. Supply both or omit both for
# manual payment. Server secrets only; no publishable key is needed.
# STRIPE_SECRET_KEY=rk_test_replace_with_your_server_key
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_endpoint_signing_secret
# Endpoint: /api/webhooks/stripe. Use API 2026-09-30.endive and events
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired.

# Private message attachments. Local storage works without an external provider.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads
# Per file, 1–100 MB; up to five attachments per message.
MAX_UPLOAD_SIZE_MB=100
# For S3-compatible storage, choose STORAGE_DRIVER=s3 and supply these four.
# AWS S3 uses its normal region; omit ENDPOINT for the standard AWS endpoint.
# R2 uses region auto and https://<account-id>.r2.cloudflarestorage.com.
# The bucket must remain PRIVATE. Credentials need PutObject/GetObject/
# DeleteObject for owned failed-upload cleanup, and HeadBucket for setup checks.
# STORAGE_S3_BUCKET=your-private-bucket
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY=replace_with_access_key
# STORAGE_S3_SECRET_KEY=replace_with_secret_key
