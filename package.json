{
  "name": "yinsen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.1 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/standalone.ts",
    "start": "tsx scripts/start.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src scripts tests '*.{json,ts,mjs,yaml}' README.md docs/operator.md docs/as-built",
    "format:check": "prettier --check src scripts tests '*.{json,ts,mjs,yaml}' README.md docs/operator.md docs/as-built",
    "test": "vitest run",
    "test:http": "tsx --env-file=.env tests/http.ts",
    "test:access": "tsx tests/access-http.ts",
    "check:markers": "node scripts/check-markers.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:markers && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:status": "tsx scripts/database.ts status"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
