{
  "name": "yinsen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.1 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/build-metadata.ts && next build && tsx scripts/standalone.ts",
    "start": "tsx scripts/start.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src scripts tests '*.{json,ts,mjs,yaml}' '*.md' '.github/workflows/*.yml'",
    "format:check": "prettier --check src scripts tests '*.{json,ts,mjs,yaml}' '*.md' '.github/workflows/*.yml'",
    "test": "vitest run",
    "test:http": "tsx tests/http.ts",
    "test:access": "tsx tests/access-http.ts",
    "test:clients": "tsx tests/clients-http.ts",
    "test:projects": "tsx tests/projects-http.ts",
    "test:messages": "tsx tests/messages-http.ts",
    "test:proposals": "tsx tests/proposals-http.ts",
    "test:deliverables": "tsx tests/deliverables-http.ts",
    "test:invoices": "tsx tests/invoices-http.ts",
    "test:analytics": "tsx tests/analytics-http.ts",
    "test:settings": "tsx tests/settings-http.ts",
    "test:setup-race": "tsx tests/setup-race.ts",
    "check:markers": "node scripts/check-markers.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:markers && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:status": "tsx scripts/database.ts status",
    "package:build": "tsx scripts/package.ts build",
    "package:verify": "tsx scripts/package.ts verify",
    "package:publish": "tsx scripts/package.ts publish",
    "package:qualify": "tsx scripts/qualify.ts",
    "test:browser": "tsx tests/package-browser.ts",
    "installation": "tsx scripts/installation.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@next/env": "16.4.2",
    "bcryptjs": "3.0.3",
    "busboy": "1.6.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
